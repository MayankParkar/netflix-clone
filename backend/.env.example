# Server
PORT=3000
NODE_ENV=development

# Seagate HDD mount path (run: ls /run/media/$USER/ to find yours)
HDD_PATH=/media/seagate/movies

# SQLite database
DATABASE_URL="file:./prisma/dev.db"

# TMDB API key — get free at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# JWT secrets — use long random strings in production
JWT_ACCESS_SECRET=change-this-to-a-long-random-string
JWT_REFRESH_SECRET=change-this-to-a-different-long-random-string
